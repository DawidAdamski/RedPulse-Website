# Response headers for Cloudflare Pages.
#
# This file replaces what nginx.conf does on the mikr.us container. Pages
# serves the static build directly, so there is no nginx in front any more —
# every security header the site relies on has to be declared here.
#
# Matching is additive: a request inherits the headers of EVERY rule whose
# pattern matches, and two rules setting the same header get their values
# joined with a comma. Two Content-Security-Policy values are not merged by
# the browser — both are enforced, so the effective policy is their
# intersection. That is why /admin first detaches the site-wide CSP ("! " in
# front of the name) before declaring its own: without the detach the CMS
# would inherit the strict policy on top of its relaxed one and its scripts
# would be blocked.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://assets.calendly.com https://calendly.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; font-src 'self' data:; img-src 'self' data: https:; frame-src https://calendly.com; connect-src 'self' https://calendly.com; base-uri 'self'; form-action 'self' https://calendly.com; object-src 'none'

# Astro fingerprints everything under /_astro/, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind ships the wiki search index as hashed chunks — same deal.
/pagefind/*
  Cache-Control: public, max-age=31536000, immutable

# Sveltia CMS. It loads its bundle from unpkg, self-hosts its typefaces and its
# Material Symbols icon font through fontsource on jsdelivr, and talks to the
# GitHub API as its backend — all of which the site-wide policy forbids. Detach
# the strict policy first, then declare the relaxed one. public/admin/index.html
# carries the same policy in a <meta> tag as a fallback in case the detach ever
# stops working.
#
# font-src is the one to watch. A blocked font raises no CSP violation in the
# console — it just fails, and the icons render as their ligature names
# ("bookmark_manager", "edit"), which reads as a broken CMS rather than as our
# own policy. fonts.gstatic.com is where Sveltia used to fetch them from and is
# kept only so a switch back does not break this again; jsdelivr is the one
# actually in use.
#
# Two patterns because a splat does not match the bare path: /admin/* covers
# /admin/ and everything under it, /admin covers the unslashed request.
/admin
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; connect-src 'self' https://unpkg.com https://api.github.com https://raw.githubusercontent.com https://*.githubusercontent.com https://github.com; frame-src 'self'; base-uri 'self'; object-src 'none'
  X-Robots-Tag: noindex
  Cache-Control: no-store

/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; connect-src 'self' https://unpkg.com https://api.github.com https://raw.githubusercontent.com https://*.githubusercontent.com https://github.com; frame-src 'self'; base-uri 'self'; object-src 'none'
  X-Robots-Tag: noindex
  Cache-Control: no-store
