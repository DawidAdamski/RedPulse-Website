---
// Distribution, not tracking: LinkedIn is a plain share-offsite link (preview built
// entirely from Open Graph tags), copy + native share are progressive enhancement on
// navigator.clipboard / navigator.share. No external scripts, no cookies — see
// docs/social/README.md. The native-share button is hidden until JS confirms support,
// so it never renders dead on desktop.
interface Labels {
  heading: string;
  linkedin: string;
  copy: string;
  copied: string;
  native: string;
}

interface Props {
  url: string;
  title: string;
  labels: Labels;
}

const { url, title, labels } = Astro.props;
const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---

<div class="share-buttons" data-share-url={url} data-share-title={title}>
  <span class="share-heading">{labels.heading}</span>
  <div class="share-actions">
    <a
      class="share-btn"
      href={linkedinHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={labels.linkedin}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
      <span>{labels.linkedin}</span>
    </a>

    <button class="share-btn" type="button" data-share-native hidden aria-label={labels.native}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="18" cy="5" r="3"/>
        <circle cx="6" cy="12" r="3"/>
        <circle cx="18" cy="19" r="3"/>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
      </svg>
      <span>{labels.native}</span>
    </button>

    <button
      class="share-btn"
      type="button"
      data-share-copy
      data-copy-label={labels.copy}
      data-copied-label={labels.copied}
    >
      <svg class="share-icon-copy" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
      <svg class="share-icon-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span data-copy-text>{labels.copy}</span>
    </button>
  </div>
  <span class="share-status" role="status" aria-live="polite"></span>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.share-buttons')) {
    const url = root.dataset.shareUrl ?? '';
    const title = root.dataset.shareTitle ?? '';
    const status = root.querySelector<HTMLElement>('.share-status');

    // Native share: reveal only where the platform supports it (mobile, mostly).
    const nativeBtn = root.querySelector<HTMLButtonElement>('[data-share-native]');
    if (nativeBtn && typeof navigator.share === 'function') {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener('click', () => {
        navigator.share({ title, url }).catch(() => {});
      });
    }

    // Copy link: the most-used action, per docs/social/README.md.
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-share-copy]');
    if (copyBtn && navigator.clipboard) {
      const textEl = copyBtn.querySelector<HTMLElement>('[data-copy-text]');
      const copyLabel = copyBtn.dataset.copyLabel ?? '';
      const copiedLabel = copyBtn.dataset.copiedLabel ?? '';
      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          // The .is-copied class swaps the icons and tints the button (CSS).
          if (textEl) textEl.textContent = copiedLabel;
          copyBtn.classList.add('is-copied');
          if (status) status.textContent = copiedLabel;
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            if (textEl) textEl.textContent = copyLabel;
            copyBtn.classList.remove('is-copied');
            if (status) status.textContent = '';
          }, 2000);
        } catch {
          /* clipboard blocked — LinkedIn link still works */
        }
      });
    } else if (copyBtn) {
      // No clipboard API: don't leave a button that does nothing.
      copyBtn.hidden = true;
    }
  }
</script>
