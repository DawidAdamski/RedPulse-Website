---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description: string;
  lang?: string;
  ogType?: string;
  canonical?: string;
  alternates?: { pl?: string; en?: string; xDefault?: string };
  publishedTime?: string;
  modifiedTime?: string;
  feed?: string;
}

const {
  title,
  description,
  lang = 'pl',
  ogType = 'website',
  canonical,
  alternates,
  publishedTime,
  modifiedTime,
  feed,
} = Astro.props;

const skipText = lang === 'pl' ? 'Przejdź do treści' : 'Skip to content';
// Link preview (docs/REDESIGN.md, D3): the face and the promise, not the logo —
// referrals see this thumbnail before they see the site. One per language.
const ogImage = lang === 'en'
  ? 'https://redpulse.tech/og-image-en.png'
  : 'https://redpulse.tech/og-image.png';

const site = Astro.site || 'https://redpulse.tech';
const canonicalURL = new URL(canonical ?? Astro.url.pathname, site);

const hreflangLinks = alternates
  ? [
      { hreflang: 'pl', path: alternates.pl },
      { hreflang: 'en', path: alternates.en },
      { hreflang: 'x-default', path: alternates.xDefault ?? alternates.pl ?? '/' },
    ]
      .filter((entry): entry is { hreflang: string; path: string } => entry.path !== undefined)
      .map((entry) => ({ hreflang: entry.hreflang, href: new URL(entry.path, site).href }))
  : [
      { hreflang: 'pl', href: 'https://redpulse.tech/' },
      { hreflang: 'en', href: 'https://redpulse.tech/en/' },
      { hreflang: 'x-default', href: 'https://redpulse.tech/' },
    ];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://redpulse.tech/#organization',
  name: 'RedPulse Innovations Dawid Adamski',
  alternateName: 'RedPulse Innovations',
  legalName: 'RedPulse Innovations Dawid Adamski',
  url: 'https://redpulse.tech',
  logo: 'https://redpulse.tech/favicon.svg',
  description: lang === 'pl'
    ? 'Stała opieka IT, projekty infrastrukturalne, automatyzacje i szkolenia z AI dla właścicieli małych firm. Jedna osoba, która ogarnia serwer, dane i sprzęt — i bierze za nie odpowiedzialność.'
    : 'Managed IT care, infrastructure projects, automation and AI training for small business owners. One person who takes care of your server, data and hardware — and takes responsibility for it.',
  taxID: '5562805527',
  vatID: 'PL5562805527',
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'NIP', value: '5562805527' },
    { '@type': 'PropertyValue', propertyID: 'REGON', value: '526676500' }
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'al. Ratuszowa 14 lok. 2',
    postalCode: '88-100',
    addressLocality: 'Inowrocław',
    addressRegion: 'kujawsko-pomorskie',
    addressCountry: 'PL'
  },
  founder: {
    '@type': 'Person',
    name: 'Dawid Adamski',
    url: 'https://www.linkedin.com/in/dawid-adamski/'
  },
  areaServed: {
    '@type': 'Country',
    name: 'Poland'
  },
  knowsAbout: [
    'Managed IT Services',
    'IT Infrastructure',
    'Backup and Disaster Recovery',
    'IT Consulting',
    'Process Automation',
    'Artificial Intelligence',
    'AI Training'
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'kontakt@redpulse.tech',
    availableLanguage: ['Polish', 'English']
  },
  sameAs: [
    'https://www.linkedin.com/company/red-pulse-innovations/',
    'https://www.linkedin.com/in/dawid-adamski/',
    'https://github.com/DawidAdamski'
  ]
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://redpulse.tech/#website',
  url: 'https://redpulse.tech',
  name: 'RedPulse Innovations',
  description: description,
  inLanguage: lang === 'pl' ? 'pl-PL' : 'en-US',
  publisher: { '@id': 'https://redpulse.tech/#organization' }
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Dawid Adamski" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    
    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Language alternates -->
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}

    <!-- RSS feed discovery -->
    {feed && <link rel="alternate" type="application/rss+xml" title={title} href={feed} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="RedPulse Innovations" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Theme -->
    <meta name="theme-color" content="#c1272d" />

    <title>{title}</title>

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{skipText}</a>
    <slot />
    <CookieConsent lang={lang === 'en' ? 'en' : 'pl'} />
  </body>
</html>
