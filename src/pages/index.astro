---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.vue';
import Hero from '../components/Hero.vue';
import About from '../components/About.vue';
import Services from '../components/Services.vue';
import FAQ from '../components/FAQ.vue';
import Contact from '../components/Contact.vue';
import Footer from '../components/Footer.vue';
import { getTranslations } from '../i18n';
import { getEntry } from 'astro:content';

const t = getTranslations('pl');
const currentLocale = 'pl';
const buildDate = new Date().toISOString();

const sections = (await getEntry('sections', currentLocale)).data;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sections.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---

<Layout
  title="RedPulse Innovations - Konsulting IT, Automatyzacja, AI"
  description="RedPulse Innovations - konsulting IT, automatyzacja procesów i wdrożenia AI dla małych i średnich firm. Specjalizujemy się w rozwiązaniach open source i technologiach Red Hat. Make it simple and innovative."
  lang="pl"
>
  <Header t={t} currentLocale={currentLocale} client:load />
  <main id="main-content">
    <Hero t={t} client:visible />
    <About about={sections.about} />
    <Services services={sections.services} />
    <FAQ faq={sections.faq} client:visible />
    <Contact t={t} />
  </main>
  <Footer t={t} lastUpdated={buildDate} locale={currentLocale} client:load />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
