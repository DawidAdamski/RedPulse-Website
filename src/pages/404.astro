---
// The 404 page.
//
// One file has to answer for both languages. Cloudflare serves dist/404.html
// for every unmatched path (`not_found_handling: "404-page"` in
// wrangler.jsonc), so there is no /en/404 it could pick instead — the same
// document comes back for /nie-ma-takiej and for /en/no-such-thing. The Polish
// copy is therefore the markup, the English copy sits alongside it hidden, and
// a few lines of inline script swap them when the path starts with /en/. With
// scripting off a visitor gets Polish, which is the site's default locale.
//
// Deliberately no Header/Footer: both are Vue islands that take a locale, and
// hydrating one language's navigation onto a page that may be showing the
// other is how you end up with a Polish menu above English copy. The mark
// links home and that is enough to get someone out of a dead end.
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.vue';
---

<Layout
  title="404 — nie znaleziono strony | RedPulse Innovations"
  description="Pod tym adresem nic nie ma. Wróć na stronę główną albo zajrzyj na bloga."
  lang="pl"
  noindex
>
  <main id="main-content" class="notfound">
    <div class="notfound-inner">
      <a class="notfound-logo" href="/" aria-label="RedPulse Innovations">
        <Logo variant="light" size={26} />
      </a>

      <p class="label-mono notfound-code">404</p>

      <div data-lang="pl">
        <h1>Tej strony tu nie ma.</h1>
        <p class="notfound-lead">
          Albo adres jest już nieaktualny, albo wkradła się w niego literówka.
          Akurat ten problem diagnozuje się szybko.
        </p>
        <div class="notfound-actions">
          <a class="btn btn-primary" href="/">Strona główna</a>
          <a class="btn btn-outline" href="/blog/">Blog</a>
        </div>
      </div>

      <div data-lang="en" hidden>
        <h1>This page isn't here.</h1>
        <p class="notfound-lead">
          Either the address is out of date, or there is a typo in it. This
          particular problem is a quick one to diagnose.
        </p>
        <div class="notfound-actions">
          <a class="btn btn-primary" href="/en/">Homepage</a>
          <a class="btn btn-outline" href="/en/blog/">Blog</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  // Runs before paint, so the English visitor never sees the Polish copy flash
  // past. Kept inline and dependency-free on purpose: a 404 is the one page
  // that has to work when the rest of the site is having a bad day.
  if (location.pathname.startsWith('/en/') || location.pathname === '/en') {
    document.documentElement.lang = 'en';
    document.title = '404 — page not found | RedPulse Innovations';
    var pl = document.querySelector('[data-lang="pl"]');
    var en = document.querySelector('[data-lang="en"]');
    if (pl && en) {
      pl.hidden = true;
      en.hidden = false;
    }
  }
</script>

<style>
  .notfound {
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--paper);
    color: var(--ink);
    padding: 2rem 1.5rem;
  }

  .notfound-inner {
    width: 100%;
    max-width: 34rem;
  }

  .notfound-logo {
    display: inline-block;
    text-decoration: none;
    margin-bottom: 3rem;
  }

  /* The code is metadata, not a headline — the brand book puts metadata in
     Plex Mono and Stone is too light for it on Paper, so Graphite it is. */
  .notfound-code {
    color: var(--graphite);
    margin-bottom: 0.75rem;
  }

  .notfound h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .notfound-lead {
    font-size: 1.0625rem;
    color: var(--gray-600);
    margin: 0 0 2.5rem;
    max-width: 30rem;
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
